{
  "name": "warm-paws",
  // 阶段 2：main 指向 API 网关 Worker —— /api/* 先进 Worker（具名端点 → Supabase REST/Storage），
  // 其余路径仍静态资源优先；SPA 兜底行为由 assets 配置决定，npm run deploy 用法不变。
  "main": "worker/api.js",
  "compatibility_date": "2025-09-01",
  // 轮 114：恢复 workers.dev 预览地址（加了 routes 后 Cloudflare 默认关闭它；之前一直开着，保持原状）
  "workers_dev": true,
  // 轮 115：旧域 dale.de5.net 已按用户要求下线（用户要拿它另做静态页）——本 Worker 唯一入口
  // = warmpaws.de5.net。**config 的 routes 会整体替换绑定集合**（踩坑 #42）：删掉条目再 deploy
  // 即解除绑定并清掉自家 DNS 记录；存量 APK 已提前全部换新包（16A59F578311CD3A，指新域）。
  "routes": [
    { "pattern": "warmpaws.de5.net", "custom_domain": true }
  ],
  // 轮 162：每分钟 cron 触发 worker/api.js 的 scheduled 自 ping（压冷启动尖峰），
  // 免费额度 10 万次/天，1440 次/天 余量充足；部署后 Cloudflare 面板可见 cron 绑定。
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    // 未知路径返回 dist/404.html（真 404 状态码）：此前 SPA 全兜底会把任意乱路径
    // 当首页 200 返回（软 404 原料，拖累 Google 收录）。真实路由全部有静态文件，
    // 前端路由不依赖回退（history 模式的每条路由都有独立 HTML）。
    "not_found_handling": "404-page",
    // 保险：即使 dist 里意外出现 api/ 目录，/api/* 也一定先进 Worker；
    // /u/*（他人主页）与 /messages/*（会话直链）带动态 id、没有预渲染文件，
    // 必须让请求先到 Worker 才能把 404 改写成 SPA 壳（见 worker/api.js 的回退分支）。
    // /post/*（轮 85 ①b）：帖子详情深链同样没有预渲染文件 —— Worker 先查帖子存在性，
    // 存在回 SPA 壳（200），查无/上游挂维持真 404（软 404 红线不动）。
    // /story/*（轮 145）：故事详情深链同口径 —— 先在 story_get 里确认这篇存在（published 或本人），
    // 存在回壳并注入标题/正文/OG，查无维持真 404。
    // /sitemap.xml（轮 85 ②）：动态 sitemap 要在静态资产之前拦截 —— 首次部署漏加它，
    // 结果线上还是静态 5 条（探针实测打脸），Worker 分支根本没机会跑。
    "run_worker_first": ["/api/*", "/u/*", "/messages/*", "/post/*", "/story/*", "/sitemap.xml", "/sb/*"]
  }
}
