{
  "name": "warm-paws",
  // 阶段 2：main 指向 API 网关 Worker —— /api/* 先进 Worker（具名端点 → Supabase REST/Storage），
  // 其余路径仍静态资源优先；SPA 兜底行为由 assets 配置决定，npm run deploy 用法不变。
  "main": "worker/api.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    // 保险：即使 dist 里意外出现 api/ 目录，/api/* 也一定先进 Worker
    "run_worker_first": ["/api/*"]
  }
}
