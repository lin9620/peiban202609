<?xml version="1.0" encoding="utf-8"?>
<!-- 轮 38：原生启动层的窗口底 = 米色。
     米色与网页端 (#fff7ee)、capacitor.config.json 的 backgroundColor 三处同值，
     所以 WebView 还没铺满时露出的也是米色，不再是一圈黑边。
     轮 43：按用户要求去掉居中爪印（「启动页不要那个大爪子的页面」）——
     本层退成纯米色，品牌呈现全部交给随后的网页启动页（#app-splash）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF7EE" />
        </shape>
    </item>
</layer-list>
