# Warm Paws 云端配置模板
# 复制本文件为 .env 后填入真实值（.env 已被 .gitignore 忽略，绝不会进仓库）
# 说明：anon/publishable key 是公开密钥，安全由 Supabase RLS 策略保证
#
# 云端部署（Cloudflare Workers / Pages）时，请在后台环境变量里配置同样两个键名：
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx