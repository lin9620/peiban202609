# 依赖与构建产物
node_modules/
dist/
# 轮 514：vendored 的库产物必须入库 —— fork 的全部意义就是这份改过的 dist，
# 漏了它 clone 下来等于没 fork（vendor-check 会红）
!vendor/*/dist/

# 私密配置：Supabase 密钥，绝不能提交
.env
.env.local
.env.*.local
# 轮 458：本地探针环境（API_BASE 置空 + /sb 反代线上 Supabase），验完即删，别进提交
.env.probe
supabase.json
.dev.vars

# 数据库备份（轮 402）：dump 里有全部用户数据，绝不入库；连接串同理
backups/
.env.backup

# 工具生成的报告与运行日志
undef-report.txt
comment-test.txt
arity-test.txt
*.log

# 本地工具缓存与临时脚本（云部署不需要）
.wrangler/
.edge-final/
/_scratch/
# UI 改版回滚点（轮 404）：整份 src 快照，体积大且只在本机有意义
/_backup/
# 本地探针构建产物 / 设计参考图 / 代理工具目录
/dist-*/
/.workbuddy/
/_icon-concepts/
/参考图片/
_*.mjs
_*.txt
_*.ps1
_*.png
tools/_*.js
# 真渲染工装（wallbar-drive / androidbar-drive）每跑一次都临时构建一份，用完自己删；
# 中断时可能留下目录，别让它进提交
tools/_*-harness-dist/

# Android / Capacitor（App 轨道红线：密钥与本地构建产物绝不提交）
*.keystore
*.jks
android/local.properties
android/app/build/
android/.capacitor/
android/.gradle/
android/build/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json

# 本地产物 APK（调试包体积大且每次构建都变；发版包走 Play 后台，不入库）
apk/

# 编辑器与系统文件
.DS_Store
Thumbs.db
.vscode/
.idea/

# 装机同步时挪出来的过期静态资源（tools/sync-assets.mjs）
.stale-assets/

# 验收对比图（历史留档，体积大，不入库；只在本机留证据）
docs/shots/
